# talaria-push-relay — example environment
#
# In-process plugin mode: export these in the environment of every hermes
# process that should push (hermes serve / hermes gateway / hermes cron),
# e.g. via the systemd unit or the shell profile that launches hermes.
# Sidecar mode: same file works for `talaria-push-sidecar` (systemd
# EnvironmentFile= friendly — no quotes needed).

# ── APNs credentials (required for any push) ────────────────────────────────
# Auth-key (.p8) token auth from developer.apple.com → Keys → Apple Push
# Notifications service. NEVER commit the .p8; chmod 600 it.
TALARIA_APNS_KEY_P8_PATH=~/.hermes/talaria-push/AuthKey_ABC123DEFG.p8
TALARIA_APNS_KEY_ID=ABC123DEFG
TALARIA_APNS_TEAM_ID=TEAM123456
# The iOS app bundle id (apns-topic header)
TALARIA_APNS_TOPIC=wtf.anderson.talaria
# Default APNs environment for devices that did not say: dev = sandbox
# (Xcode/dev builds), prod = App Store / TestFlight builds. Each device
# registration may override per-device.
TALARIA_APNS_ENV=dev

# ── Relay behaviour ─────────────────────────────────────────────────────────
# Which event kinds THIS process may push. Comma list from:
#   approval, long_task, mention, routine, gateway
# Recommended split when running hook mode + sidecar together (avoids
# double pushes — see README "Two modes"):
#   hermes processes (hook mode):  approval,long_task,mention,routine
#   sidecar:                       gateway
# Sidecar-only deployments (no plugin installed): approval,long_task,routine,gateway
#TALARIA_PUSH_EVENTS=approval,long_task,mention,routine

# Kill switch: set to 1 to disable all pushes from this process.
#TALARIA_PUSH_DISABLE=0

# "Long task done" threshold in seconds (default 600 = 10 minutes).
#TALARIA_PUSH_LONG_TASK_MIN_S=600

# @handles that count as a mention of this bot in inbound gateway messages
# (comma list, without the @). Default: the current profile name.
#TALARIA_PUSH_MENTION_HANDLES=ops-bot,opsbot

# Approval surfaces that should push (comma list of gateway,cli,smart).
# Default "gateway" — CLI approvals mean a human is already at the
# terminal, and "smart" approvals are auto-decided by the auxiliary LLM.
#TALARIA_PUSH_APPROVAL_SURFACES=gateway

# Bot name override for push attribution (default: the hermes profile
# name, derived from HERMES_HOME; the sidecar defaults to "hermes").
#TALARIA_PUSH_BOT_NAME=

# ── Sidecar mode only ───────────────────────────────────────────────────────
# The `hermes serve` gateway to watch.
TALARIA_GATEWAY_URL=http://127.0.0.1:9119
# Dashboard session token. Leave empty on loopback to auto-scrape
# window.__HERMES_SESSION_TOKEN__ from GET / (the token the served SPA
# embeds; it rotates on every server restart). Set explicitly when the
# server was started with HERMES_DASHBOARD_SESSION_TOKEN pinned.
#TALARIA_GATEWAY_TOKEN=
# /api/health polling cadence and how many consecutive failures mean
# "gateway offline".
#TALARIA_PUSH_HEALTH_INTERVAL_S=15
